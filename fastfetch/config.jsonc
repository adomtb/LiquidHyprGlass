{
    // Généré par Matugen — ne pas éditer directement.
    // Source : ~/.config/matugen/templates/fastfetch-colors.jsonc
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "color": {
            "1": "#2f628c"
        },
        "padding": {
            "right": 4
        }
    },

    "display": {
        "separator": " ",
        "key": {
            "width": 9
        }
    },

    "modules": [
        {
            "type": "user",
            "key": " user",
            "keyColor": "#d3bfe6"
        },
        {
            "type": "os",
            "key": " distro",
            "keyColor": "#9bcbfb"
        },
        {
            "type": "kernel",
            "key": " kernel",
            "keyColor": "#9bcbfb"
        },
        {
            "type": "terminal",
            "key": " term",
            "keyColor": "#ffb4ab"
        },
        {
            "type": "wm",
            "key": " wm",
            "keyColor": "#c2c7cf"
        },
        {
            "type": "disk",
            "key": " disk",
            "keyColor": "#9bcbfb",
            "folders": "/"
        },
        {
            "type": "colors",
            "key": " colors",
            "keyColor": "#9bcbfb",
            "symbol": "diamond"
        }
    ]
}
